    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
@model IEnumerable<LeAn_day3.Models.ProductViewModel>

@{
    ViewData["Title"] = "Products";
    int currentPage = (int)ViewBag.CurrentPage;
    int totalPages = (int)ViewBag.TotalPages;
}

<h1>Products</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>

<form asp-action="Index" method="get">
    <input type="text"
           name="searchString"
           value="@ViewBag.SearchString"
           placeholder="Search product or category" />

    <input type="hidden" name="sortOrder" value="@ViewBag.SortOrder" />

    <button type="submit">Search</button>
    <a asp-action="Index">Clear</a>
</form>

<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>
                <a asp-action="Index"
                   asp-route-searchString="@ViewBag.SearchString"
                   asp-route-sortOrder="@ViewBag.NameSort">
                    Name
                </a>
            </th>
            <th>
                <a asp-action="Index"
                   asp-route-searchString="@ViewBag.SearchString"
                   asp-route-sortOrder="@ViewBag.PriceSort">
                    Price
                </a>
            </th>
            <th>Category</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ProductId</td>
                <td>@item.ProductName</td>
                <td>@item.ProductPrice</td>
                <td>@item.CategoryName</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.ProductId">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.ProductId">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.ProductId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<p>Page @currentPage of @totalPages</p>

@if (currentPage > 1)
{
    <a asp-action="Index"
       asp-route-searchString="@ViewBag.SearchString"
       asp-route-sortOrder="@ViewBag.SortOrder"
       asp-route-pageNumber="@(currentPage - 1)">
        Previous
    </a>
}

@if (currentPage < totalPages)
{
    <a asp-action="Index"
       asp-route-searchString="@ViewBag.SearchString"
       asp-route-sortOrder="@ViewBag.SortOrder"
       asp-route-pageNumber="@(currentPage + 1)">
        Next
    </a>
}