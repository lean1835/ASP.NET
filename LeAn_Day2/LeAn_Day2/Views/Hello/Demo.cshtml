@model LeAn_Day2.Models.StudentInfo
@{
    ViewData["Title"] = "Demo Partial View và View Component";
}

<div class="container py-2">
    <!-- Tiêu đề trang -->
    <div class="border-bottom pb-3 mb-4">
        <h4 class="fw-bold mb-1">Ví Dụ: Partial View &amp; View Component</h4>
        <p class="text-secondary mb-0 small">
            Minh họa cách sử dụng và phân biệt hai kỹ thuật tái sử dụng giao diện trong ASP.NET Core MVC.
        </p>
    </div>

    <!-- 2 Cột so sánh -->
    <div class="row g-3">
        <!-- CỘT 1: PARTIAL VIEW -->
        <div class="col-md-6">
            <div class="card h-100 border">
                <div class="card-header bg-white py-2">
                    <strong class="text-dark">1. Partial View</strong>
                </div>
                <div class="card-body">
                    <p class="text-secondary small mb-3">
                        Giao diện con dùng chung. Dữ liệu bắt buộc phải do <code>HelloController</code> chuẩn bị và truyền qua Model.
                    </p>

                    <!-- Render Partial View -->
                    <partial name="_StudentCardPartial" model="Model" />

                    <div class="mt-3">
                        <span class="text-secondary small d-block mb-1">Cách gọi trong Razor:</span>
                        <pre class="bg-light border p-2 rounded small mb-0"><code>&lt;partial name="_StudentCardPartial" model="Model" /&gt;</code></pre>
                    </div>
                </div>
            </div>
        </div>

        <!-- CỘT 2: VIEW COMPONENT -->
        <div class="col-md-6">
            <div class="card h-100 border">
                <div class="card-header bg-white py-2">
                    <strong class="text-dark">2. View Component</strong>
                </div>
                <div class="card-body">
                    <p class="text-secondary small mb-3">
                        Component độc lập. Tự có code C# và tự lấy dữ liệu, <code>HelloController</code> không cần truyền gì.
                    </p>

                    <!-- Render View Component -->
                    <vc:top-students top-count="3"></vc:top-students>

                    <div class="mt-3">
                        <span class="text-secondary small d-block mb-1">Cách gọi trong Razor:</span>
                        <pre class="bg-light border p-2 rounded small mb-0"><code>&lt;vc:top-students top-count="3"&gt;&lt;/vc:top-students&gt;</code></pre>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- BẢNG SO SÁNH TÓM TẮT -->
    <div class="card mt-4 border">
        <div class="card-header bg-white py-2">
            <strong class="text-dark">Bảng so sánh tóm tắt</strong>
        </div>
        <div class="table-responsive">
            <table class="table table-bordered table-sm mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 25%;">Tiêu chí</th>
                        <th style="width: 37%;">Partial View</th>
                        <th style="width: 38%;">View Component</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="text-secondary">Cấu trúc</td>
                        <td>1 file <code>.cshtml</code></td>
                        <td>1 class C# (<code>ViewComponent</code>) + 1 file view (<code>Default.cshtml</code>)</td>
                    </tr>
                    <tr>
                        <td class="text-secondary">Nguồn dữ liệu</td>
                        <td>Nhận từ View cha / Controller cha</td>
                        <td>Tự lấy dữ liệu qua logic C# riêng (hoặc inject Service)</td>
                    </tr>
                    <tr>
                        <td class="text-secondary">Dependency Injection</td>
                        <td>Hạn chế (chỉ inject trong view)</td>
                        <td>Đầy đủ qua Constructor như Controller</td>
                    </tr>
                    <tr>
                        <td class="text-secondary">Cú pháp gọi</td>
                        <td><code>&lt;partial name="..." model="..." /&gt;</code></td>
                        <td><code>&lt;vc:tên-component /&gt;</code></td>
                    </tr>
                    <tr>
                        <td class="text-secondary">Trường hợp sử dụng</td>
                        <td>Chia nhỏ HTML, card mẫu, form con</td>
                        <td>Widget độc lập: menu, giỏ hàng, bảng tin, thống kê</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
