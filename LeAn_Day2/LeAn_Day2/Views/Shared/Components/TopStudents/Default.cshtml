@model List<LeAn_Day2.Models.StudentInfo>

@*
    VIEW CỦA VIEW COMPONENT: TopStudents
    - Nhận dữ liệu tự truy vấn từ TopStudentsViewComponent.cs
*@

<div class="card border rounded-2 h-100">
    <div class="card-header bg-light d-flex justify-content-between align-items-center py-2">
        <span class="fw-semibold text-dark">Top @Model.Count Sinh Viên Điểm Cao</span>
        <span class="text-secondary small">View Component</span>
    </div>
    <ul class="list-group list-group-flush">
        @for (int i = 0; i < Model.Count; i++)
        {
            var student = Model[i];
            <li class="list-group-item d-flex justify-content-between align-items-center py-2">
                <div>
                    <span class="text-secondary me-2">@(i + 1).</span>
                    <span class="text-dark">@student.FullName</span>
                    <span class="text-secondary small ms-1">(@student.Major)</span>
                </div>
                <div class="text-end">
                    <span class="fw-semibold text-dark me-2">@student.Gpa.ToString("0.00")</span>
                    <span class="text-secondary small">@student.Classification</span>
                </div>
            </li>
        }
    </ul>
    <div class="card-footer bg-white text-muted small py-2">
        Nguồn: View Component (TopStudentsViewComponent)
    </div>
</div>
