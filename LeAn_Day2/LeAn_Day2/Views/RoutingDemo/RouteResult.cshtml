@{
    ViewData["Title"] = "Kết quả phân tích Routing";
}

<div class="container py-3" style="max-width: 720px;">
    <div class="card border rounded-2">
        <div class="card-header bg-light py-2 d-flex justify-content-between align-items-center">
            <span class="fw-semibold text-dark">Kết quả phân tích Routing</span>
            <span class="badge bg-secondary-subtle text-dark border">Thực thi thành công</span>
        </div>
        <div class="card-body">
            <div class="mb-3">
                <span class="text-secondary small d-block">Loại Routing đã xử lý:</span>
                <span class="fw-bold text-dark fs-5">@ViewBag.RouteType</span>
            </div>

            <div class="mb-3">
                <span class="text-secondary small d-block">URL hiện tại của request:</span>
                <code class="bg-light border px-2 py-1 rounded text-dark">@ViewBag.RequestedUrl</code>
            </div>

            <div class="mb-3">
                <span class="text-secondary small d-block">Mẫu Route đã khớp:</span>
                <code class="bg-light border px-2 py-1 rounded text-dark">@ViewBag.MatchedPattern</code>
            </div>

            <div class="mb-3">
                <span class="text-secondary small d-block">Tham số nhận được:</span>
                <ul class="list-unstyled mb-0 ps-2 border-start border-2 mt-1">
                    <li class="small mb-1">
                        <span class="text-secondary">Tham số ID:</span>
                        <span class="fw-semibold text-dark">@ViewBag.ParamId</span>
                    </li>
                    @if (ViewBag.Slug != null)
                    {
                        <li class="small">
                            <span class="text-secondary">Tham số Slug:</span>
                            <span class="fw-semibold text-dark">@ViewBag.Slug</span>
                        </li>
                    }
                </ul>
            </div>

            <div class="bg-light p-3 rounded border mb-3">
                <span class="fw-semibold text-dark small d-block mb-1">Giải thích cơ chế:</span>
                <p class="text-secondary small mb-0">@ViewBag.Explanation</p>
            </div>

            <a href="/RoutingDemo" class="btn btn-outline-secondary btn-sm">
                &larr; Quay lại danh sách thử nghiệm Routing
            </a>
        </div>
    </div>
</div>
