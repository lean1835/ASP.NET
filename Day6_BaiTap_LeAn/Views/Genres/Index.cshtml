@model IEnumerable<Day6_BaiTap_LeAn.Models.Genre>

@{
    ViewData["Title"] = "Quản lý thể loại";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Thể loại phim</h1>
    <a asp-action="Create" class="btn btn-primary">Thêm thể loại</a>
</div>

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Mã</th>
            <th>Tên thể loại</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var genre in Model)
        {
            <tr>
                <td>@genre.Id</td>
                <td>@genre.Name</td>
                <td class="text-end">
                    <a asp-action="Details" asp-route-id="@genre.Id" class="btn btn-sm btn-outline-secondary">Chi tiết</a>
                    <a asp-action="Edit" asp-route-id="@genre.Id" class="btn btn-sm btn-outline-primary">Sửa</a>
                    <a asp-action="Delete" asp-route-id="@genre.Id" class="btn btn-sm btn-outline-danger">Xóa</a>
                </td>
            </tr>
        }
    </tbody>
</table>
